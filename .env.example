# Адрес Supabase-проекта. Этого достаточно: клиент ходит только в
# Edge Function /functions/v1/me, а она проверяет подпись initData.
# anon/service-ключи в клиент не попадают.
VITE_SUPABASE_URL=https://xxxxxxx.supabase.co

# Необязательно: если функция лежит по другому адресу, переопредели его.
# VITE_PROFILE_ENDPOINT=https://xxxxxxx.supabase.co/functions/v1/me
